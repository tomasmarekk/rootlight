[package]
edition = "2018"
name = "tree-sitter-pascal"
version = "0.10.2"
build = "bindings/rust/build.rs"
include = [
    "LICENSE",
    "bindings/rust/*",
    "grammar.js",
    "queries/highlights.scm",
    "queries/locals.scm",
    "src/*",
]
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "Pascal grammar for the tree-sitter parsing library"
readme = "README.md"
keywords = [
    "incremental",
    "parsing",
    "pascal",
    "delphi",
]
categories = [
    "parsing",
    "text-editors",
]
license = "MIT"
repository = "https://github.com/Isopod/tree-sitter-pascal"

[lib]
name = "tree_sitter_pascal"
path = "bindings/rust/lib.rs"

[dependencies.tree-sitter-language]
version = "0.1"

[dev-dependencies.tree-sitter]
version = "0.24"

[build-dependencies.cc]
version = "1.0"
