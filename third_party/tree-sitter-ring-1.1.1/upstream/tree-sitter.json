{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ring",
      "camelcase": "Ring",
      "title": "the Ring Programming Language",
      "scope": "source.ring",
      "path": ".",
      "file-types": [
        "rh",
        "ring",
        "rform"
      ],
      "injection-regex": "^ring$",
      "class-name": "TreeSitterRing",
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  ],
  "metadata": {
    "version": "1.1.1",
    "license": "MIT",
    "description": "Tree-Sitter grammer for the Ring Programming Language",
    "authors": [
      {
        "name": "Youssef Saeed",
        "email": "youssefelkholey@gmail.com",
        "url": "https://github.com/ysdragon"
      }
    ],
    "links": {
      "repository": "https://github.com/ysdragon/tree-sitter-ring",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}