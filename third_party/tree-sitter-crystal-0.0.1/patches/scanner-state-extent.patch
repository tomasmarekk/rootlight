+// Validate the complete extent before copying any serialized state into arrays.
+// A failed restoration leaves the same empty state as a zero-length reset.
+static bool valid_serialized_state(const char *buffer, unsigned length) {
+    if (buffer == NULL || length < 6 || length > TREE_SITTER_SERIALIZATION_BUFFER_SIZE) {
+        return false;
+    }
+
+    for (size_t i = 0; i < 4; i++) {
+        if ((uint8_t)buffer[i] > 1) {
+            return false;
+        }
+    }
+
+    size_t offset = 4;
+    uint8_t literals_size = (uint8_t)buffer[offset++];
+    if (literals_size > (length - offset) / sizeof(PercentLiteral)) {
+        return false;
+    }
+    for (uint8_t i = 0; i < literals_size; i++) {
+        PercentLiteral literal;
+        memcpy(&literal, &buffer[offset], sizeof literal);
+        if (literal.type > REGEX) {
+            return false;
+        }
+        offset += sizeof literal;
+    }
+
+    if (offset == length) {
+        return false;
+    }
+    uint8_t heredocs_size = (uint8_t)buffer[offset++];
+    if (heredocs_size > MAX_HEREDOC_COUNT) {
+        return false;
+    }
+    size_t identifier_bytes = 0;
+    for (uint8_t i = 0; i < heredocs_size; i++) {
+        if (length - offset < 3 || (uint8_t)buffer[offset] > 1 || (uint8_t)buffer[offset + 1] > 1) {
+            return false;
+        }
+        uint8_t identifier_size = (uint8_t)buffer[offset + 2];
+        offset += 3;
+        if (identifier_size > length - offset || identifier_size > HEREDOC_BUFFER_SIZE - identifier_bytes) {
+            return false;
+        }
+        identifier_bytes += identifier_size;
+        offset += identifier_size;
+    }
+    return offset == length;
+}
