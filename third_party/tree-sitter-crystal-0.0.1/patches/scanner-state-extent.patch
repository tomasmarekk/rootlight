+// The wire format has four flags, two one-byte counts, fixed literal records
+// and three bytes plus an identifier per heredoc. Admission precedes mutation.
+static bool serialized_state_fits(State *state, size_t added_literals, size_t added_heredocs, size_t added_identifier_bytes) {
+    if (added_literals > UINT8_MAX || state->literals.size > UINT8_MAX - added_literals
+        || added_heredocs > UINT8_MAX || state->heredocs.size > UINT8_MAX - added_heredocs) {
+        return false;
+    }
+    size_t remaining = TREE_SITTER_SERIALIZATION_BUFFER_SIZE - 6;
+    size_t literals = state->literals.size + added_literals;
+    if (literals > remaining / sizeof(PercentLiteral)) {
+        return false;
+    }
+    remaining -= literals * sizeof(PercentLiteral);
+    size_t heredocs = state->heredocs.size + added_heredocs;
+    if (heredocs > remaining / 3) {
+        return false;
+    }
+    remaining -= heredocs * 3;
+    for (size_t i = 0; i < state->heredocs.size; i++) {
+        size_t identifier_bytes = array_get(&state->heredocs, i)->identifier.size;
+        if (identifier_bytes > remaining) {
+            return false;
+        }
+        remaining -= identifier_bytes;
+    }
+    return added_identifier_bytes <= remaining;
+}
 
