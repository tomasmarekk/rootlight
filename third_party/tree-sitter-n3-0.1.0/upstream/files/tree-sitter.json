{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "n3",
      "camelcase": "N3",
      "title": "N3",
      "scope": "source.n3",
      "file-types": [
        "n3"
      ],
      "injection-regex": "^n3$",
      "class-name": "TreeSitterN3"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree sitter grammar for Notation3",
    "authors": [
      {
        "name": "Gordian Dziwis, Eldar Yusupov",
        "email": "eyusupov@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/eyusupov/tree-sitter-n3"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}