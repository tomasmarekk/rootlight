+# Local unpublished binding for retained MIT XML and DTD grammar sources.
+# Compilation uses static ABI14 inputs without generation or acquisition.
+[package]
+name = "tree-sitter-xml"
+version = "0.7.0"
+edition = "2024"
+rust-version = "1.90"
+license = "MIT"
+repository = "https://github.com/tree-sitter-grammars/tree-sitter-xml"
+description = "Pinned XML and DTD grammars with local static language bindings"
+publish = false
+build = "bindings/rust/build.rs"
+
+[lib]
+path = "bindings/rust/lib.rs"
+
+[dependencies]
+tree-sitter-language = "=0.1.7"
+
+[build-dependencies]
+cc = "=1.2.67"
