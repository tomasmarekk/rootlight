+    const unsigned char* bytes = (const unsigned char*)buffer;
+    if(bytes[0] != SCANNER_STATE_VERSION || (bytes[1] & ~3u) || bytes[2] > 4) return;
+    uint32_t base = 0;
+    for(unsigned index = 0; index < 4; index++){
+        base |= (uint32_t)bytes[3 + index] << (8u * index);
+    }
+    if((uintmax_t)base > (uintmax_t)INT_MAX) return;
+    TokenType bit_string_base;
+    switch(bytes[2]){
+        case 0: bit_string_base = IDENTIFIER; break;
+        case 1: bit_string_base = BASE_SPECIFIER_BINARY; break;
+        case 2: bit_string_base = BASE_SPECIFIER_OCTAL; break;
+        case 3: bit_string_base = BASE_SPECIFIER_DECIMAL; break;
+        case 4: bit_string_base = BASE_SPECIFIER_HEX; break;
+        default: return;
+    }
+    scanner->is_in_directive = (bytes[1] & 1u) != 0;
+    scanner->is_block_comment = (bytes[1] & 2u) != 0;
+    scanner->bit_string_base = bit_string_base;
+    scanner->base = (int)base;
