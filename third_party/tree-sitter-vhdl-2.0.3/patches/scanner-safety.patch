+
+/* Some token-tree matches are ambiguous until their suffix is consumed. Only
+ * commit state after the final emitted token satisfies the caller's mask. */
+bool tree_sitter_vhdl_external_scanner_scan(Scanner* scanner, TSLexer* lexer, const bool* valid_symbols)
+{
+    if(!scanner || !lexer || !valid_symbols) return false;
+    Scanner candidate = *scanner;
+    if(!scan_vhdl(&candidate, lexer, valid_symbols)) return false;
+    if(lexer->result_symbol >= ERROR_SENTINEL ||
+       !valid_symbols[lexer->result_symbol]) return false;
+    *scanner = candidate;
+    return true;
+}
