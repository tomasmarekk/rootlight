+/* Tree-sitter can restore an empty state before any external token. Keep this
+ * representation independent of C padding, enum width and bool layout. */
+enum { SCANNER_STATE_VERSION = 1, SCANNER_STATE_BYTES = 7 };
+_Static_assert(SCANNER_STATE_BYTES <= TREE_SITTER_SERIALIZATION_BUFFER_SIZE,
+               "scanner state exceeds the Tree-sitter serialization buffer");
+
+static bool encode_bit_string_base(TokenType base, uint8_t* encoded)
+{
+    switch(base){
+        case IDENTIFIER:             *encoded = 0; return true;
+        case BASE_SPECIFIER_BINARY:  *encoded = 1; return true;
+        case BASE_SPECIFIER_OCTAL:   *encoded = 2; return true;
+        case BASE_SPECIFIER_DECIMAL: *encoded = 3; return true;
+        case BASE_SPECIFIER_HEX:     *encoded = 4; return true;
+        default: return false;
+    }
+}
