+       (uintmax_t)scanner->base > UINT32_MAX ||
+       !encode_bit_string_base(scanner->bit_string_base, &encoded_base)) return 0;
+    uint32_t base = (uint32_t)scanner->base;
+    buffer[0] = SCANNER_STATE_VERSION;
+    buffer[1] = (char)((scanner->is_in_directive ? 1u : 0u) |
+                       (scanner->is_block_comment ? 2u : 0u));
+    buffer[2] = (char)encoded_base;
