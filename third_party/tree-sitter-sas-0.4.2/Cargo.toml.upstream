[package]
edition = "2021"
name = "tree-sitter-sas"
version = "0.4.2"
authors = ["Brandon Garate <bgarate@ix-infra.com>"]
build = "bindings/rust/build.rs"
include = [
    "bindings/rust/*",
    "grammar.js",
    "queries/*",
    "src/*",
    "tree-sitter.json",
    "/LICENSE",
]
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "SAS language grammar for tree-sitter"
readme = "README.md"
keywords = [
    "incremental",
    "parsing",
    "tree-sitter",
    "tree-sitter-sas",
]
categories = [
    "parser-implementations",
    "parsing",
    "text-editors",
]
license = "MIT"
repository = "https://github.com/ix-infrastructure/tree-sitter-sas"

[lib]
name = "tree_sitter_sas"
path = "bindings/rust/lib.rs"

[dependencies.tree-sitter-language]
version = "0.1"

[dev-dependencies.tree-sitter]
version = "0.26.8"

[build-dependencies.cc]
version = "1.2"
