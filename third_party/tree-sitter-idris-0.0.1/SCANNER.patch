+static bool idris_string_push(String *text, uint32_t value) {
+  if (!rootlight_idris_scope_step()) return false;
+  if (value > 0x10ffffu || (value >= 0xd800u && value <= 0xdfffu)) {
+    rootlight_idris_scope_refuse(ROOTLIGHT_IDRIS_INVALID_SCALAR);
+    return false;
+  }
+  unsigned width = value < 0x80u ? 1u : value < 0x800u ? 2u : value < 0x10000u ? 3u : 4u;
+  if (text->size >= IDRIS_TOKEN_CAPACITY
+      || (value && width >= IDRIS_TOKEN_CAPACITY - text->size)) {
+    rootlight_idris_scope_refuse(ROOTLIGHT_IDRIS_CAPACITY);
+    return false;
+  }
+  if (!value) {
+    text->contents[text->size++] = 0;
+    return true;
+  }
+  unsigned at = text->size;
+  if (width == 1u) text->contents[at++] = (char)value;
+  else {
+    text->contents[at++] = (char)((width == 2u ? 0xc0u : width == 3u ? 0xe0u : 0xf0u)
+      | (value >> (6u * (width - 1u))));
+    for (unsigned remaining = width - 1u; remaining; --remaining)
+      text->contents[at++] = (char)(0x80u | ((value >> (6u * (remaining - 1u))) & 0x3fu));
+  }
+  text->size = at;
+  text->contents[at] = 0;
+  return true;
+}
+
+static bool idris_stack_push(U32Stack *stack, uint32_t value) {
+  if (!rootlight_idris_scope_step()) return false;
+  if (stack->size >= IDRIS_STACK_CAPACITY) {
+    rootlight_idris_scope_refuse(ROOTLIGHT_IDRIS_CAPACITY);
+    return false;
+  }
+  stack->contents[stack->size++] = value;
+  return true;
+}
+
+static uint32_t *idris_stack_get(U32Stack *stack, uint32_t index) {
+  static uint32_t zero;
+  if (!rootlight_idris_scope_step()) return &zero;
+  if (stack->size > IDRIS_STACK_CAPACITY || index >= stack->size) {
+    rootlight_idris_scope_refuse(ROOTLIGHT_IDRIS_MALFORMED_STATE);
+    return &zero;
+  }
+  return &stack->contents[index];
+}
+
+static void idris_stack_pop(U32Stack *stack) {
+  if (!rootlight_idris_scope_step()) return;
+  if (!stack->size || stack->size > IDRIS_STACK_CAPACITY) {
+    rootlight_idris_scope_refuse(ROOTLIGHT_IDRIS_MALFORMED_STATE);
+    return;
+  }
+  --stack->size;
+}
