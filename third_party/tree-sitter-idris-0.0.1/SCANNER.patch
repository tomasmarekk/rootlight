+
+static uint32_t idris_read_u32(const unsigned char *raw) {
+  return (uint32_t)raw[0] | ((uint32_t)raw[1] << 8u)
+    | ((uint32_t)raw[2] << 16u) | ((uint32_t)raw[3] << 24u);
+}
+
+static void idris_write_u32(unsigned char *raw, uint32_t value) {
+  for (unsigned at = 0; at < 4u; ++at) raw[at] = (unsigned char)(value >> (8u * at));
+}
