<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rootlight per-user daemon task template. Import is opt-in and must use the
  current user's least-privilege token.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="CurrentUser">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
  </Settings>
  <Actions Context="CurrentUser">
    <Exec>
      <Command>%LOCALAPPDATA%\Rootlight\current\bin\rootlight-daemon.exe</Command>
    </Exec>
  </Actions>
</Task>
