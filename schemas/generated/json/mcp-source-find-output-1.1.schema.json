{
  "$id": "https://rootlight.local/schema/mcp/source.find/output/1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EntityToolResponse",
  "description": "Success or checked domain error sharing one exact contract revision.",
  "type": "object",
  "anyOf": [
    {
      "description": "Tool-specific successful result.",
      "$ref": "#/$defs/SourceFindEnvelope"
    },
    {
      "description": "Checked source-redacted domain error.",
      "$ref": "#/$defs/EntityErrorResponse"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "CacheStatus": {
      "description": "Cache classification for usage reporting.",
      "oneOf": [
        {
          "description": "No cache entry was used.",
          "type": "string",
          "const": "miss"
        },
        {
          "description": "A verified generation-bound cache entry was used.",
          "type": "string",
          "const": "hit"
        },
        {
          "description": "The operator does not use a cache.",
          "type": "string",
          "const": "not_applicable"
        }
      ]
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^b3_[a-z2-7]{58}$"
    },
    "ContinuationCursor": {
      "description": "A bounded opaque continuation cursor.",
      "type": "string",
      "maxLength": 4096,
      "minLength": 1
    },
    "DetailKey": {
      "description": "A validated key for a bounded public error detail.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "EntityErrorResponse": {
      "description": "Checked domain error under one exact source-entity contract revision.",
      "type": "object",
      "properties": {
        "error": {
          "description": "Source-free error and remediation.",
          "$ref": "#/$defs/PublicError"
        },
        "schema_version": {
          "description": "Exact error contract version.",
          "$ref": "#/$defs/SourceFindSchemaVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "error"
      ]
    },
    "ErrorCode": {
      "description": "Stable public error families shared by all Rootlight boundaries.",
      "oneOf": [
        {
          "description": "The caller supplied an invalid value.",
          "type": "string",
          "const": "INVALID_ARGUMENT"
        },
        {
          "description": "The requested entity does not exist.",
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "description": "The request conflicts with current state.",
          "type": "string",
          "const": "CONFLICT"
        },
        {
          "description": "The selected generation is no longer valid for this operation.",
          "type": "string",
          "const": "STALE_GENERATION"
        },
        {
          "description": "The requested capability is unavailable.",
          "type": "string",
          "const": "UNSUPPORTED_CAPABILITY"
        },
        {
          "description": "The result is incomplete for the requested coverage.",
          "type": "string",
          "const": "INCOMPLETE_COVERAGE"
        },
        {
          "description": "The operation exceeded an explicit work budget.",
          "type": "string",
          "const": "BUDGET_EXCEEDED"
        },
        {
          "description": "A bounded resource is exhausted.",
          "type": "string",
          "const": "RESOURCE_EXHAUSTED"
        },
        {
          "description": "The operation was cancelled before completion.",
          "type": "string",
          "const": "CANCELLED"
        },
        {
          "description": "An isolated adapter failed.",
          "type": "string",
          "const": "ADAPTER_FAILED"
        },
        {
          "description": "An index failed integrity checks.",
          "type": "string",
          "const": "INDEX_CORRUPT"
        },
        {
          "description": "Stored data requires a supported migration.",
          "type": "string",
          "const": "MIGRATION_REQUIRED"
        },
        {
          "description": "Policy denied the requested operation.",
          "type": "string",
          "const": "PERMISSION_DENIED"
        },
        {
          "description": "A protocol or contract version is incompatible.",
          "type": "string",
          "const": "PROTOCOL_MISMATCH"
        },
        {
          "description": "A conflicting operation temporarily owns the resource.",
          "type": "string",
          "const": "BUSY"
        },
        {
          "description": "An internal failure cannot be safely disclosed.",
          "type": "string",
          "const": "INTERNAL"
        },
        {
          "description": "A pagination cursor is invalid, expired, forged, or context-mismatched.",
          "type": "string",
          "const": "INVALID_CURSOR"
        },
        {
          "description": "A supplied value has the wrong type for its target field.",
          "type": "string",
          "const": "TYPE_MISMATCH"
        },
        {
          "description": "The request exceeded a cost limit before execution.",
          "type": "string",
          "const": "COST_LIMIT"
        },
        {
          "description": "The query uses an operator outside the documented allowlist.",
          "type": "string",
          "const": "OPERATOR_FORBIDDEN"
        },
        {
          "description": "A batch binding reference is malformed or unresolved.",
          "type": "string",
          "const": "BINDING_INVALID"
        },
        {
          "description": "A batch binding produced a value of the wrong type for its target.",
          "type": "string",
          "const": "BINDING_TYPE_MISMATCH"
        }
      ]
    },
    "FileId": {
      "type": "string",
      "pattern": "^file1_[a-z2-7]{39}$"
    },
    "GenerationId": {
      "type": "string",
      "pattern": "^gen1_[a-z2-7]{39}$"
    },
    "LineRange": {
      "description": "A validated one-based inclusive source line range.",
      "type": "object",
      "properties": {
        "end_line": {
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 1
        },
        "start_line": {
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line"
      ]
    },
    "NextAction": {
      "description": "Stable remediation hints generated from a closed set of templates.",
      "oneOf": [
        {
          "description": "Correct one named input field.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "correct_field"
            },
            "field": {
              "description": "Stable name of the invalid field.",
              "$ref": "#/$defs/DetailKey"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "field"
          ]
        },
        {
          "description": "Retry after the bounded delay in the envelope.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "retry"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Select a compatible contract version.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "select_supported_version"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Inspect the associated operation status.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "inspect_operation"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Rebuild the affected repository generation.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "rebuild_repository"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Collect a protected source-free support bundle.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "collect_support_bundle"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Restart the enumeration or query from the beginning after an invalid\ncontinuation cursor.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "restart_enumeration"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        }
      ]
    },
    "OperationId": {
      "type": "string",
      "pattern": "^op1_[a-z2-7]{32}$"
    },
    "PublicError": {
      "description": "A stable source-redacted failure safe to serialize across public boundaries.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9_]+$": {
              "$ref": "#/$defs/PublicValue"
            }
          }
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "next_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NextAction"
          },
          "maxItems": 8
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryId"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 86400000,
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details",
        "next_actions"
      ]
    },
    "PublicValue": {
      "description": "Bounded primitive values permitted in public error details.",
      "oneOf": [
        {
          "description": "A boolean property.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A signed integer property.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "An unsigned integer property.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unsigned"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A repository identity.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "repository"
            },
            "value": {
              "$ref": "#/$defs/RepositoryId"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A generation identity.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "generation"
            },
            "value": {
              "$ref": "#/$defs/GenerationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "An operation identity.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "operation"
            },
            "value": {
              "$ref": "#/$defs/OperationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A validated source-free label.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "label"
            },
            "value": {
              "$ref": "#/$defs/SafeLabel"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "RepositoryId": {
      "type": "string",
      "pattern": "^repo1_[a-z2-7]{32}$"
    },
    "RequiredNullable": {
      "description": "A property that must be present and may contain JSON `null`.",
      "anyOf": [
        {
          "$ref": "#/$defs/ContinuationCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "ResolvedRepository": {
      "description": "Resolved repository metadata.",
      "type": "object",
      "properties": {
        "display_name": {
          "description": "Rootlight-owned display label.",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "repository_id": {
          "description": "Stable repository identity.",
          "$ref": "#/$defs/RepositoryId"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository_id",
        "display_name"
      ]
    },
    "SafeLabel": {
      "description": "A short source-free label permitted in public diagnostics.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "SourceFindData": {
      "description": "One bounded page; match bodies and unknown total counts are never copied.",
      "type": "object",
      "properties": {
        "file": {
          "description": "Shared physical source identity and repository metadata.",
          "$ref": "#/$defs/SourceFindFile"
        },
        "matches": {
          "description": "Exact matches in strictly increasing start order, including overlaps.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 1024
        },
        "restoration_bytes": {
          "description": "Independently charged lookbehind used to validate a restored prefix.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "scanned_end_byte": {
          "description": "Exclusive original-byte forward scan end.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "scanned_start_byte": {
          "description": "Inclusive original-byte forward scan start; UTF-16 begins after its BOM.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "stop": {
          "description": "Actual stop boundary, distinct from whole-language completeness.",
          "$ref": "#/$defs/SourceFindStop"
        },
        "total_metadata_bytes": {
          "description": "Exact UTF-8 byte lengths of the shared path and language metadata.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "total_response_memory_bytes": {
          "description": "Owned source-response allocation, excluding matched bodies (never copied).",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "matches",
        "scanned_start_byte",
        "scanned_end_byte",
        "restoration_bytes",
        "stop",
        "total_metadata_bytes",
        "total_response_memory_bytes"
      ]
    },
    "SourceFindEnvelope": {
      "description": "Generation-pinned source-only response, without structural coverage claims.",
      "type": "object",
      "properties": {
        "data": {
          "description": "Bounded physical source work and exact matches.",
          "$ref": "#/$defs/SourceFindData"
        },
        "generation": {
          "description": "Immutable generation used for every page and source reference.",
          "$ref": "#/$defs/GenerationId"
        },
        "next_cursor": {
          "description": "Authenticated continuation, absent exactly at end of source.",
          "$ref": "#/$defs/RequiredNullable"
        },
        "repository": {
          "description": "Resolved repository identity.",
          "$ref": "#/$defs/ResolvedRepository"
        },
        "schema_version": {
          "description": "Exact tool contract revision.",
          "$ref": "#/$defs/SourceFindSchemaVersion"
        },
        "truncated": {
          "description": "True exactly when the page stopped before end of source.",
          "type": "boolean"
        },
        "trust": {
          "description": "Classification for all repository-derived metadata and references.",
          "$ref": "#/$defs/TrustClassification"
        },
        "usage": {
          "description": "Runtime response and execution accounting; source_bytes is zero.",
          "$ref": "#/$defs/UsageSummary"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repository",
        "generation",
        "data",
        "truncated",
        "next_cursor",
        "usage",
        "trust"
      ]
    },
    "SourceFindFile": {
      "description": "Single shared file identity for all original-byte match references.",
      "type": "object",
      "properties": {
        "byte_length": {
          "description": "Complete physical source length including any BOM.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "content_hash": {
          "description": "Hash of the complete original physical source.",
          "$ref": "#/$defs/ContentHash"
        },
        "encoding": {
          "description": "Original physical encoding.",
          "$ref": "#/$defs/SourceTextEncoding"
        },
        "extracted_from": {
          "description": "Whole immediate physical container of an extracted source, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated": {
          "description": "Indexed generated-file marker.",
          "type": "boolean"
        },
        "id": {
          "description": "Indexed file identity.",
          "$ref": "#/$defs/FileId"
        },
        "language": {
          "description": "Indexed language identity without a support-level claim.",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "path": {
          "description": "Repository-relative display path, never a host selector.",
          "type": "string",
          "maxLength": 65536,
          "minLength": 1
        },
        "trust": {
          "description": "Mandatory classification of repository-controlled metadata.",
          "$ref": "#/$defs/TrustClassification"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "language",
        "content_hash",
        "byte_length",
        "encoding",
        "generated",
        "trust"
      ]
    },
    "SourceFindSchemaVersion": {
      "description": "Exact source-find response revision with verification-duration provenance.",
      "oneOf": [
        {
          "description": "Source find contract 1.1.",
          "type": "string",
          "const": "1.1"
        }
      ]
    },
    "SourceFindStop": {
      "description": "Actual reason a page stopped; only EndOfSource completes the scan.",
      "oneOf": [
        {
          "description": "The forward scan reached the complete physical source end.",
          "type": "string",
          "const": "end_of_source"
        },
        {
          "description": "The requested forward physical-byte ceiling was reached.",
          "type": "string",
          "const": "scan_limit"
        },
        {
          "description": "The caller's maximum_matches ceiling was reached.",
          "type": "string",
          "const": "match_limit"
        },
        {
          "description": "Internal matcher memory limited the returned page.",
          "type": "string",
          "const": "matcher_memory_limit"
        },
        {
          "description": "Owned source-response memory limited the returned page.",
          "type": "string",
          "const": "response_memory_limit"
        },
        {
          "description": "A transport result ceiling below maximum_matches stopped the page.",
          "type": "string",
          "const": "result_limit"
        }
      ]
    },
    "SourceRef": {
      "description": "A generation-bound reference to immutable repository source.",
      "type": "object",
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "generation": {
          "$ref": "#/$defs/GenerationId"
        },
        "line_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "$ref": "#/$defs/RepositoryId"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "generation",
        "span",
        "content_hash"
      ]
    },
    "SourceSpan": {
      "description": "A validated half-open source byte span within one file.",
      "type": "object",
      "properties": {
        "end_byte": {
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "file": {
          "$ref": "#/$defs/FileId"
        },
        "start_byte": {
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "start_byte",
        "end_byte"
      ]
    },
    "SourceTextEncoding": {
      "description": "Physical encoding of original source bytes.",
      "oneOf": [
        {
          "description": "Original UTF-8 bytes.",
          "type": "string",
          "const": "utf-8"
        },
        {
          "description": "BOM-marked UTF-16 little endian.",
          "type": "string",
          "const": "utf-16le"
        },
        {
          "description": "BOM-marked UTF-16 big endian.",
          "type": "string",
          "const": "utf-16be"
        }
      ]
    },
    "TrustClassification": {
      "description": "Trust classification attached to every future source-bearing value.",
      "oneOf": [
        {
          "description": "Content originated in a repository and must be treated as data.",
          "type": "string",
          "const": "untrusted_repository_data"
        }
      ]
    },
    "UsageSummary": {
      "description": "Bounded counters returned by each read tool.",
      "type": "object",
      "properties": {
        "cache_status": {
          "description": "Cache outcome.",
          "$ref": "#/$defs/CacheStatus"
        },
        "edges": {
          "description": "Relationship edges examined.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "estimated_tokens": {
          "description": "Deterministic token estimate.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "json_bytes": {
          "description": "Encoded structured result bytes.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "rows": {
          "description": "Storage rows examined.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "source_bytes": {
          "description": "Raw source bytes returned.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "trace_id": {
          "description": "Source-free trace identity.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "wall_time_ms": {
