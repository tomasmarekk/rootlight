{
  "$id": "https://rootlight.local/schema/mcp/operation.status/output/1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationToolResponse",
  "description": "Success-or-error response for repository-operation schema 1.1.",
  "type": "object",
  "anyOf": [
    {
      "description": "Tool-specific successful response.",
      "$ref": "#/$defs/OperationStatusSuccessV1_1"
    },
    {
      "description": "Checked source-redacted domain error.",
      "$ref": "#/$defs/OperationErrorResponse"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "DetailKey": {
      "description": "A validated key for a bounded public error detail.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "ErrorCode": {
      "description": "Stable public error families shared by all Rootlight boundaries.",
      "oneOf": [
        {
          "description": "The caller supplied an invalid value.",
          "type": "string",
          "const": "INVALID_ARGUMENT"
        },
        {
          "description": "The requested entity does not exist.",
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "description": "The request conflicts with current state.",
          "type": "string",
          "const": "CONFLICT"
        },
        {
          "description": "The selected generation is no longer valid for this operation.",
          "type": "string",
          "const": "STALE_GENERATION"
        },
        {
          "description": "The requested capability is unavailable.",
          "type": "string",
          "const": "UNSUPPORTED_CAPABILITY"
        },
        {
          "description": "The result is incomplete for the requested coverage.",
          "type": "string",
          "const": "INCOMPLETE_COVERAGE"
        },
        {
          "description": "The operation exceeded an explicit work budget.",
          "type": "string",
          "const": "BUDGET_EXCEEDED"
        },
        {
          "description": "A bounded resource is exhausted.",
          "type": "string",
          "const": "RESOURCE_EXHAUSTED"
        },
        {
          "description": "The operation was cancelled before completion.",
          "type": "string",
          "const": "CANCELLED"
        },
        {
          "description": "An isolated adapter failed.",
          "type": "string",
          "const": "ADAPTER_FAILED"
        },
        {
          "description": "An index failed integrity checks.",
          "type": "string",
          "const": "INDEX_CORRUPT"
        },
        {
          "description": "Stored data requires a supported migration.",
          "type": "string",
          "const": "MIGRATION_REQUIRED"
        },
        {
          "description": "Policy denied the requested operation.",
          "type": "string",
          "const": "PERMISSION_DENIED"
        },
        {
          "description": "A protocol or contract version is incompatible.",
          "type": "string",
          "const": "PROTOCOL_MISMATCH"
        },
        {
          "description": "A conflicting operation temporarily owns the resource.",
          "type": "string",
          "const": "BUSY"
        },
        {
          "description": "An internal failure cannot be safely disclosed.",
          "type": "string",
          "const": "INTERNAL"
        },
        {
          "description": "A pagination cursor is invalid, expired, forged, or context-mismatched.",
          "type": "string",
          "const": "INVALID_CURSOR"
        },
        {
          "description": "A supplied value has the wrong type for its target field.",
          "type": "string",
          "const": "TYPE_MISMATCH"
        },
        {
          "description": "The request exceeded a cost limit before execution.",
          "type": "string",
          "const": "COST_LIMIT"
        },
        {
          "description": "The query uses an operator outside the documented allowlist.",
          "type": "string",
          "const": "OPERATOR_FORBIDDEN"
        },
        {
          "description": "A batch binding reference is malformed or unresolved.",
          "type": "string",
          "const": "BINDING_INVALID"
        },
        {
          "description": "A batch binding produced a value of the wrong type for its target.",
          "type": "string",
          "const": "BINDING_TYPE_MISMATCH"
        }
      ]
    },
    "GenerationId": {
      "type": "string",
      "pattern": "^gen1_[a-z2-7]{39}$"
    },
    "NextAction": {
      "description": "Stable remediation hints generated from a closed set of templates.",
      "oneOf": [
        {
          "description": "Correct one named input field.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "correct_field"
            },
            "field": {
              "description": "Stable name of the invalid field.",
              "$ref": "#/$defs/DetailKey"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "field"
          ]
        },
        {
          "description": "Retry after the bounded delay in the envelope.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "retry"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Select a compatible contract version.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "select_supported_version"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Inspect the associated operation status.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "inspect_operation"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Rebuild the affected repository generation.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "rebuild_repository"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Collect a protected source-free support bundle.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "collect_support_bundle"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "description": "Restart the enumeration or query from the beginning after an invalid\ncontinuation cursor.",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "restart_enumeration"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        }
      ]
    },
    "OperationBuildStrategy": {
      "description": "Construction strategy retained with a successful repository operation.",
      "oneOf": [
        {
          "description": "No committed parent generation was available.",
          "type": "string",
          "const": "initial"
        },
        {
          "description": "Declared dependencies selected bounded artifact reuse.",
          "type": "string",
          "const": "dependency_directed"
        },
        {
          "description": "Missing dependency evidence required a repository-wide rebuild.",
          "type": "string",
          "const": "conservative_repository_rebuild"
        },
        {
          "description": "An identical retained generation was reactivated without rebuilding it.",
          "type": "string",
          "const": "retained_generation"
        }
      ]
    },
    "OperationDetailV1_1": {
      "description": "One operation journal view.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Operation kind.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "progress": {
          "description": "Bounded progress counters.",
          "$ref": "#/$defs/OperationProgress"
        },
        "resources": {
          "description": "Bounded resource summary.",
          "$ref": "#/$defs/OperationResourcesV1_1"
        },
        "revision": {
          "description": "Monotonic journal revision.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "stage": {
          "description": "Current source-free stage name.",
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "started_at": {
          "description": "RFC 3339 UTC creation time.",
          "type": "string",
          "maxLength": 35,
          "minLength": 20
        },
        "state": {
          "description": "Durable state.",
          "$ref": "#/$defs/OperationState"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "state",
        "stage",
        "progress",
        "revision",
        "started_at",
        "resources"
      ]
    },
    "OperationErrorResponse": {
      "description": "Checked error response for repository-operation schema 1.1.",
      "type": "object",
      "properties": {
        "error": {
          "description": "Stable source-redacted error.",
          "$ref": "#/$defs/PublicError"
        },
        "schema_version": {
          "description": "Tool error schema version.",
          "$ref": "#/$defs/OperationSchemaVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "error"
      ]
    },
    "OperationFallbackReason": {
      "description": "Source-free reason fine-grained invalidation expanded to a full rebuild.",
      "oneOf": [
        {
          "description": "A changed input had no declared dependent edge.",
          "type": "string",
          "const": "missing_dependency_declaration"
        },
        {
          "description": "Fixed-point dependency traversal reached its configured work ceiling.",
          "type": "string",
          "const": "closure_work_exceeded"
        }
      ]
    },
    "OperationId": {
      "type": "string",
      "pattern": "^op1_[a-z2-7]{32}$"
    },
    "OperationIncrementalEvidenceV1_1": {
      "description": "Durable source-free invalidation, reuse, and rebuild evidence.",
      "type": "object",
      "properties": {
        "build_strategy": {
          "description": "Construction strategy used by this operation.",
          "$ref": "#/$defs/OperationBuildStrategy"
        },
        "changed_files": {
          "description": "Authoritative file transitions observed by reconciliation.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "changed_inputs": {
          "description": "Typed generation inputs changed from the parent snapshot.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "fallback_reason": {
          "description": "Explicit reason dependency-directed reuse was abandoned, when applicable.",
          "$ref": "#/$defs/RequiredNullable3"
        },
        "invalidated_units": {
          "description": "Analysis units selected by the invalidation closure.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "rebuilt_facts": {
          "description": "Normalized facts rebuilt for the published generation.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "rebuilt_files": {
          "description": "Source files lowered into fresh generation-bound facts.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "reused_facts": {
          "description": "Generation-bound normalized facts reused without rewriting.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "reused_files": {
          "description": "Source files whose immutable artifacts were reused.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "build_strategy",
        "fallback_reason",
        "invalidated_units",
        "changed_inputs",
        "changed_files",
        "reused_files",
        "rebuilt_files",
        "reused_facts",
        "rebuilt_facts"
      ]
    },
    "OperationProgress": {
      "description": "Progress units reported by an operation.",
      "type": "object",
      "properties": {
        "completed_units": {
          "description": "Completed units.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "total_units": {
          "description": "Known total units, when measurable.",
          "$ref": "#/$defs/RequiredNullable"
        }
      },
      "additionalProperties": false,
      "required": [
        "completed_units",
        "total_units"
      ]
    },
    "OperationResourcesV1_1": {
      "description": "Bounded resource counters for one operation.",
      "type": "object",
      "properties": {
        "bytes_examined": {
          "description": "Source bytes examined so far.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "files_examined": {
          "description": "Files examined so far.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "newly_written_bytes": {
          "description": "Bytes confirmed by operation-owned durable writer boundaries.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "owned_memory_bytes": {
          "description": "Retained generation-memory charge, separate from process RSS.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "peak_rss_bytes": {
          "description": "Peak resident bytes observed so far.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "referenced_bytes": {
          "description": "Existing artifact or generation bytes referenced by this operation.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "reserved_memory_bytes": {
          "description": "Conservative generation-memory reservation, separate from process RSS.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        },
        "written_bytes": {
          "description": "Durable bytes written so far.",
          "type": "integer",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "peak_rss_bytes",
        "written_bytes",
        "files_examined",
        "referenced_bytes",
        "newly_written_bytes",
        "reserved_memory_bytes",
        "owned_memory_bytes"
      ]
    },
    "OperationSchemaVersion": {
      "description": "Version marker carried by additive repository-operation responses.",
      "oneOf": [
        {
          "description": "Tool contract version 1.1.",
          "type": "string",
          "const": "1.1"
        }
      ]
    },
    "OperationState": {
      "description": "Durable operation state.",
      "oneOf": [
        {
          "description": "Accepted but not started.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "Actively running.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Published an immutable generation.",
          "type": "string",
          "const": "published"
        },
        {
          "description": "Failed without publishing partial state.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Cancelled without publishing partial state.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Waiting for explicit build or environment context.",
          "type": "string",
          "const": "waiting_for_context"
        }
      ]
    },
    "OperationStatusDataV1_1": {
      "description": "`operation.status` result data.",
      "type": "object",
      "properties": {
        "error": {
          "description": "Terminal public error, if any.",
          "$ref": "#/$defs/RequiredNullable4"
        },
        "incremental": {
          "description": "Final invalidation, reuse, and rebuild evidence, when published.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationIncrementalEvidenceV1_1"
            },
            {
              "type": "null"
            }
          ]
        },
        "index_stage": {
          "description": "Current source-free repository-index stage.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "minLength": 1
        },
        "operation": {
          "description": "Current operation view.",
          "$ref": "#/$defs/OperationDetailV1_1"
        },
        "published_generation": {
          "description": "Generation published by the operation, if any.",
          "$ref": "#/$defs/RequiredNullable2"
        },
        "retry_after_ms": {
          "description": "Recommended delay before polling again.",
          "$ref": "#/$defs/RequiredNullable5"
        },
        "semantic_operation_id": {
          "description": "Separately journaled semantic refinement created by a successful Auto operation.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "published_generation",
        "error",
        "retry_after_ms"
      ]
    },
    "OperationStatusSuccessV1_1": {
      "description": "Strict output for `operation.status`.",
      "type": "object",
      "properties": {
        "data": {
          "description": "Operation result.",
          "$ref": "#/$defs/OperationStatusDataV1_1"
        },
        "schema_version": {
          "description": "Tool response schema version.",
          "$ref": "#/$defs/OperationSchemaVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "data"
      ]
    },
    "PublicError": {
      "description": "A stable source-redacted failure safe to serialize across public boundaries.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9_]+$": {
              "$ref": "#/$defs/PublicValue"
            }
          }
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "next_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NextAction"
          },
          "maxItems": 8
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryId"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "maximum": 86400000,
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details",
        "next_actions"
      ]
    },
    "PublicValue": {
      "description": "Bounded primitive values permitted in public error details.",
      "oneOf": [
        {
          "description": "A boolean property.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A signed integer property.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "An unsigned integer property.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unsigned"
            },
            "value": {
              "type": "integer",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A repository identity.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "repository"
            },
            "value": {
              "$ref": "#/$defs/RepositoryId"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A generation identity.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "generation"
            },
            "value": {
              "$ref": "#/$defs/GenerationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "An operation identity.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "operation"
            },
            "value": {
              "$ref": "#/$defs/OperationId"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A validated source-free label.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "label"
            },
            "value": {
              "$ref": "#/$defs/SafeLabel"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "RepositoryId": {
      "type": "string",
      "pattern": "^repo1_[a-z2-7]{32}$"
    },
    "RequiredNullable": {
      "description": "A property that must be present and may contain JSON `null`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0
    },
    "RequiredNullable2": {
      "description": "A property that must be present and may contain JSON `null`.",
      "anyOf": [
        {
          "$ref": "#/$defs/GenerationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "RequiredNullable3": {
      "description": "A property that must be present and may contain JSON `null`.",
      "anyOf": [
        {
          "$ref": "#/$defs/OperationFallbackReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "RequiredNullable4": {
      "description": "A property that must be present and may contain JSON `null`.",
      "anyOf": [
        {
          "$ref": "#/$defs/PublicError"
        },
        {
          "type": "null"
        }
      ]
    },
    "RequiredNullable5": {
      "description": "A property that must be present and may contain JSON `null`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "SafeLabel": {
      "description": "A short source-free label permitted in public diagnostics.",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  }
}
