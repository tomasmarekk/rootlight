{
  "name": "lightningcss",
  "version": "1.33.0",
  "license": "MPL-2.0",
  "description": "A CSS parser, transformer, and minifier written in Rust",
  "main": "node/index.js",
  "types": "node/index.d.ts",
  "exports": {
    "types": "./node/index.d.ts",
    "import": "./node/index.mjs",
    "require": "./node/index.js"
  },
  "browserslist": "last 2 versions, not dead",
  "targets": {
    "main": false,
    "types": false
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/parcel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/parcel-bundler/lightningcss.git"
  },
  "engines": {
    "node": ">= 12.0.0"
  },
  "napi": {
    "name": "lightningcss"
  },
  "files": [
    "node/*.js",
    "node/*.mjs",
    "node/*.d.ts",
    "node/*.flow"
  ],
  "dependencies": {
    "detect-libc": "^2.0.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.14.0",
    "flowgen": "^1.21.0",
    "typescript": "^5.7.2",
    "uvu": "^0.5.6"
  },
  "scripts": {
    "build": "node scripts/build.js && node scripts/build-flow.js",
    "build-release": "node scripts/build.js --release && node scripts/build-flow.js",
    "prepublishOnly": "node scripts/build-flow.js",
    "tsc": "tsc -p node/tsconfig.json",
    "test": "uvu node/test"
  },
  "private": true
}
