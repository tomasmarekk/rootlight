+    fn parse(input: &mut Parser<'cmt, 's>) -> PResult<Self> {
+        let (_, plus_span) = expect!(input, Plus);
+        let prelude = input.parse::<SassInclude>()?;
+        let block = if matches!(peek!(input).token, Token::Indent(..)) {
+            Some(
+                input
+                    .with_state(ParserState {
+                        sass_ctx: input.state.sass_ctx
+                            | super::state::SASS_CTX_ALLOW_KEYFRAME_BLOCK,
+                        ..input.state.clone()
+                    })
+                    .parse::<SimpleBlock>()?,
+            )
+        } else {
+            None
+        };
+        let end = block
+            .as_ref()
+            .map_or(prelude.span.end, |block| block.span.end);
+        let start = plus_span.start;
+        Ok(Self {
+            plus_span,
+            prelude,
+            block,
+            span: Span { start, end },
+        })
+    }
+}
