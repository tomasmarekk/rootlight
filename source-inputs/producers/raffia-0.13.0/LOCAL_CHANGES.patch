+                ..input.state.clone()
+            })
+            .parse::<SimpleBlock>()?;
+        let start = equal_span.start;
+        let end = block.span.end.max(prelude.span.end);
+        Ok(Self {
+            equal_span,
+            prelude,
+            block,
+            span: Span { start, end },
+        })
+    }
