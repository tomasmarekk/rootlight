{
  "compilerOptions": {
    "composite": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": ["eslint.config.js", "playwright.config.ts", "vite.config.ts", "scripts", "tests/e2e"]
}
